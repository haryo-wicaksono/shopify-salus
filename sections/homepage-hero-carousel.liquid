{%- comment -%}
  A slide button linking to #bf-early-access opens the Klaviyo early-access popup (form VziA8P)
  instead of reloading the page. Arriving with that hash (e.g. from the campaign email) opens it too.
  Klaviyo only opens a form that is live.
{%- endcomment -%}
{%- assign early_access_used = false -%}
{%- for block in section.blocks -%}
  {%- if block.settings.button1_link contains 'bf-early-access' or block.settings.button2_link contains 'bf-early-access' -%}
    {%- assign early_access_used = true -%}
  {%- endif -%}
{%- endfor -%}
{%- if early_access_used -%}
  <script>
    (function () {
      var formId = 'VziA8P';
      function openEarlyAccess() {
        window._klOnsite = window._klOnsite || [];
        window._klOnsite.push(['openForm', formId]);
      }
      if (window.location.hash === '#bf-early-access') {
        if (document.readyState === 'complete') {
          openEarlyAccess();
        } else {
          window.addEventListener('load', openEarlyAccess);
        }
      }
      document.addEventListener('click', function (event) {
        var link = event.target.closest && event.target.closest('a[href*="#bf-early-access"]');
        if (!link) return;
        var url = new URL(link.href, window.location.href);
        if (url.pathname !== window.location.pathname) return;
        event.preventDefault();
        openEarlyAccess();
      });
    })();
  </script>
{%- endif -%}

