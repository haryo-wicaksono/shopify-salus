      display: none;
    }

    .homepage-hero-carousel__content-inner--pencil .homepage-hero-carousel__reviews-text {
      white-space: nowrap;
    }

    /* Pencil style: hand correction on a light background */
    .homepage-hero-carousel__content-column--centered .homepage-hero-carousel__content-inner--pencil {
