                            muted: true,
                            playsinline: true,
                            preload: "metadata",
                            controls: false
                          }}
                        </template>
                      {% endif %}
                    {% endif %}
                  {%- else -%}
                    {%- comment -%}Image-only (existing behavior){%- endcomment -%}
                    {% assign desktop_image = block.settings.slide_image_desktop %}
                    {% assign mobile_image = block.settings.slide_image_mobile %}

