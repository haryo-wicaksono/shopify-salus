{% comment %}
  ============================================================
  Section: Homepage Hero Carousel
  ============================================================
  This section creates a dynamic, multi-slide hero carousel
  for the homepage, featuring configurable content and imagery.
  It supports both desktop and mobile specific images and
  content styling.
{% endcomment %}

{% comment %} Swiper CSS loaded globally via theme.liquid {% endcomment %}
{{ 'homepage-hero-carousel.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Optional strike-through date line ("Starting On ~~November 27~~ NOW!").
  Styles and the script fonts load only when a slide fills "Crossed-out text".
  Style "pencil" = hand correction for light backgrounds: dark text, the word written above the
  struck date with a caret under it.
{%- endcomment -%}
{%- assign strike_line_used = false -%}
{%- for block in section.blocks -%}
  {%- if block.settings.strike_text != blank -%}
    {%- assign strike_line_used = true -%}
  {%- endif -%}
{%- endfor -%}
{%- if strike_line_used -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&family=Kaushan+Script&family=Playfair+Display:ital,wght@1,800&display=swap">
  <style>
    .homepage-hero-carousel__content-column--centered .homepage-hero-carousel__content-inner--strike {
      max-width: 760px;
    }

    .homepage-hero-carousel__slide-inner--full-bg-centered:has(.homepage-hero-carousel__content-inner--strike:not(.homepage-hero-carousel__content-inner--pencil)) .homepage-hero-carousel__bg-media::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 2;
      background: linear-gradient(90deg, rgba(0, 0, 0, 0.65) 0%, rgba(0, 0, 0, 0.3) 45%, rgba(0, 0, 0, 0) 75%);
      pointer-events: none;
    }

    .homepage-hero-carousel__content-inner--strike .homepage-hero-carousel__headline {
      font-weight: 700;
      font-size: 54px;
      letter-spacing: -0.01em;
      margin-bottom: 6px;
    }

    .homepage-hero-carousel__strike-line {
      position: relative;
      display: inline-block;
      margin: 0 2.4em 34px 0;
