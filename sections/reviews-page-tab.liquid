{%- comment -%}
  Reviews Tab Section
  - Tab 1: Google Elfsight Widget
  - Tab 2: Trustpilot (free-plan compliant): link to our profile + Trustpilot's own
    free Review Collector TrustBox (built in below, unedited).
    Trustpilot's brand guidelines don't allow free-plan businesses to show their
    TrustScore, star rating, Trustpilot logo or copied reviews.
  - Mobile Tabs side-by-side (768px breakpoint)
{%- endcomment -%}

<style>
  .reviews-section-wrapper {
    position: relative;
    width: 100%;
    margin: 30px 0 40px;
  }

  /* --- TABS STYLING --- */
  .reviews-tab-header {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .review-tab-btn {
    padding: 10px 24px;
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
    border: 1px solid #000000;
    background-color: #ffffff;
    color: #000000;
    border-radius: 4px;
    transition: all 0.3s ease;
    min-width: 180px;
    text-align: center;
  }

  .review-tab-btn:hover {
    border: 1px solid #1b413e;
    background-color: #1b413e;
    color: #ffffff;
  }

  .review-tab-btn.active {
    border: 1px solid #1f8a81;
    background-color: #1f8a81;
    color: #ffffff;
  }

  @media (max-width: 768px) {
    .reviews-tab-header {
      flex-wrap: nowrap;
      gap: 10px;
      padding: 0 5px;
      margin-bottom: 20px;
    }

    .review-tab-btn {
      min-width: 0;
      flex: 1;
      padding: 12px 4px;
      font-size: 14px;
      white-space: nowrap;
    }
  }

  /* --- CONTENT VISIBILITY --- */
  .review-content-wrapper {
    display: none;
    width: 100%;
    animation: fadeIn 0.4s ease;
  }
  .review-content-wrapper.active {
    display: block;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(5px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* --- TRUSTPILOT PANEL (links only) --- */
  .tp-panel {
    background-color: #f8f8f8;
    border-radius: 16px;
    padding: 40px 32px;
    text-align: center;
  }

  .tp-panel__title {
    font-size: 24px;
    font-weight: 700;
    color: #111;
    line-height: 1.3;
    margin: 0 0 10px;
  }

  .tp-panel__text {
    font-size: 16px;
    line-height: 1.5;
    color: #555;
    max-width: 560px;
    margin: 0 auto 24px;
  }

  .tp-panel__actions {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .tp-panel__btn {
    display: inline-block;
    padding: 15px 30px;
    border-radius: 50px;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .tp-panel__btn--primary {
    border: 1px solid #1b413e;
    background-color: #1b413e;
    color: #ffffff;
  }
  .tp-panel__btn--primary:hover {
    border-color: #1f8a81;
    background-color: #1f8a81;
    color: #ffffff;
  }

  .tp-panel__widget {
    margin-top: 28px;
  }

  @media (max-width: 768px) {
    .tp-panel {
      padding: 28px 20px;
    }
    .tp-panel__title {
      font-size: 22px;
    }
    .tp-panel__actions {
      flex-direction: column;
      align-items: stretch;
    }
    .tp-panel__btn {
      text-align: center;
      white-space: normal;
    }
  }

  .section.relative.section--full-width.section--padded-default.cc-animate-init.cc-animate-in {
    padding-top: 0px;
  }

  .section.color-scheme--transparent.cc-animate-init.cc-animate-in {
    padding-bottom: 0px;
  }

  .reviews-section-wrapper {
    margin-top: 0px;
    padding-top: 0px;
  }
  .section.relative.section--full-width.section--padded-default.cc-animate-init.cc-animate-in {
    margin-top: 30px;
  }
</style>

<div
  class="section relative section--full-width{% unless section.settings.section_height == "tight" %} section--padded-{{ section.settings.section_height }}{% endunless %}{% if section.settings.dividers != "none" %} {{ section.settings.dividers }}{% endif %}"
  data-cc-animate
>
  {%- unless section.settings.full_width -%}
    <div class="container">
  {%- endunless -%}

  <div class="reviews-section-wrapper">
    {%- assign google_on = section.settings.enable_google -%}
    {%- assign trust_on = section.settings.enable_trustpilot -%}
    {%- assign tp_profile_url = section.settings.tp_profile_url | default: 'https://www.trustpilot.com/review/www.salussaunas.com' -%}

    {%- if google_on and trust_on -%}
      <div class="reviews-tab-header">
        <button class="review-tab-btn active" data-target="google" onclick="switchTab(event, 'google')">
          Google Reviews
        </button>
        <button class="review-tab-btn" data-target="trustpilot" onclick="switchTab(event, 'trustpilot')">
          Trustpilot Reviews
        </button>
      </div>
    {%- endif -%}

    {%- if google_on -%}
      <div id="content-google" class="review-content-wrapper active">
        <script src="https://static.elfsight.com/platform/platform.js" data-use-service-core defer></script>
        <div class="elfsight-app-c9f596c6-bdba-4c64-949a-cacabaf0f6d1" data-elfsight-app-lazy></div>
      </div>
    {%- endif -%}

    {%- if trust_on -%}
      <div id="content-trustpilot" class="review-content-wrapper {% if google_on == false %}active{% endif %}">
        <div class="tp-panel">
          <h3 class="tp-panel__title">{{ section.settings.tp_title }}</h3>
          {%- if section.settings.tp_text != blank -%}
            <p class="tp-panel__text">{{ section.settings.tp_text }}</p>
          {%- endif -%}

          <div class="tp-panel__actions">
            <a
              href="{{ tp_profile_url }}"
              target="_blank"
              rel="noopener"
              class="tp-panel__btn tp-panel__btn--primary"
            >
              Read our reviews on Trustpilot
            </a>
          </div>

          <div class="tp-panel__widget">
            {%- if section.settings.tp_trustbox != blank -%}
              {{ section.settings.tp_trustbox }}
            {%- else -%}
              <!-- TrustBox script -->
              <script type="text/javascript" src="//widget.trustpilot.com/bootstrap/v5/tp.widget.bootstrap.min.js" async></script>
              <!-- End TrustBox script -->
              <!-- TrustBox widget - Review Collector -->
              <div class="trustpilot-widget" data-locale="en-US" data-template-id="56278e9abfbbba0bdcd568bc" data-businessunit-id="61ca05ef409636017d8dc02d" data-style-height="52px" data-style-width="100%" data-token="76f99f4b-0f79-48cc-859c-39acc66bbe25">
                <a href="https://www.trustpilot.com/review/www.salussaunas.com" target="_blank" rel="noopener">Trustpilot</a>
              </div>
              <!-- End TrustBox widget -->
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>

  {%- unless section.settings.full_width -%}
    </div>
  {%- endunless -%}
</div>

<script>
  function switchTab(evt, platform) {
    document.querySelectorAll('.review-content-wrapper').forEach((el) => el.classList.remove('active'));
    document.querySelectorAll('.review-tab-btn').forEach((btn) => btn.classList.remove('active'));

    var selectedContent = document.getElementById('content-' + platform);
    if (selectedContent) selectedContent.classList.add('active');

    if (evt && evt.currentTarget) {
      evt.currentTarget.classList.add('active');
    }
  }
</script>

{% schema %}
{
  "name": "Reviews Tabs",
  "settings": [
    { "type": "header", "content": "Visibility" },
    { "type": "checkbox", "id": "enable_google", "label": "Enable Google Reviews", "default": true },
    { "type": "checkbox", "id": "enable_trustpilot", "label": "Enable Trustpilot tab", "default": true },
    { "type": "header", "content": "Trustpilot tab" },
    {
      "type": "paragraph",
      "content": "On Trustpilot's free plan we can't show our TrustScore, stars, the Trustpilot logo or copied reviews. This tab links to our profile and shows Trustpilot's free Review Collector widget."
    },
    { "type": "text", "id": "tp_title", "label": "Title", "default": "See what our customers say on Trustpilot" },
    {
      "type": "textarea",
      "id": "tp_text",
      "label": "Text",
      "default": "Read our customers' reviews on Trustpilot, or share your own experience with Salus Saunas."
    },
    {
      "type": "url",
      "id": "tp_profile_url",
      "label": "Trustpilot profile URL",
      "info": "Empty = https://www.trustpilot.com/review/www.salussaunas.com"
    },
    {
      "type": "url",
      "id": "tp_review_url",
      "label": "Not used",
      "info": "The Review Collector widget below already opens the review form."
    },
    {
      "type": "html",
      "id": "tp_trustbox",
      "label": "Replace TrustBox code (optional)",
      "info": "Leave empty: the free Review Collector widget is already built in. Only paste a different free widget from Trustpilot Business (Share & promote > Website widgets), unedited."
    },
    { "type": "text", "id": "tp_rating_score", "label": "Not used (Trustpilot rules)" },
    { "type": "text", "id": "tp_review_count", "label": "Not used (Trustpilot rules)" },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "label": "Section height",
      "id": "section_height",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "tight", "label": "Tight" }
      ],
      "default": "default"
    },
    { "type": "checkbox", "id": "full_width", "label": "Make section full width", "default": false },
    {
      "type": "select",
      "id": "dividers",
      "label": "Dividing lines",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "border-top", "label": "Above" },
        { "value": "border-bottom", "label": "Below" }
      ],
      "default": "none"
    }
  ],
  "blocks": [
    {
      "type": "review_card",
      "name": "Review Card (not shown)",
      "settings": [
        {
          "type": "paragraph",
          "content": "Not shown on the site: copying Trustpilot reviews isn't allowed on the free plan. You can delete these blocks."
        },
        { "type": "text", "id": "title", "label": "Review Title" },
        { "type": "textarea", "id": "text", "label": "Review Text" },
        { "type": "text", "id": "author", "label": "Author Name" },
        { "type": "image_picker", "id": "review_image", "label": "Author Photo" },
        { "type": "text", "id": "date", "label": "Date" },
        { "type": "text", "id": "product_name", "label": "Product Purchased (Optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews Tabs"
    }
  ]
}
{% endschema %}
