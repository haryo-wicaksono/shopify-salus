{{ 'homepage-reviews-slider-2.css' | asset_url | stylesheet_tag }}
{{ 'homepage-reviews-carousel.css' | asset_url | stylesheet_tag }}

<style>
  /* Buttons + Trustpilot widget side by side, top-aligned, centered as a group */
  .homepage-reviews-slider__action-area.homepage-reviews-slider__action-row {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 85px;
    padding-top: 0;
  }

  /* Same shape and size as Trustpilot's "Review us on Trustpilot" button (184x38) */
  .homepage-reviews-slider__action-row .homepage-reviews-slider__button {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 184px;
    height: 38px;
    margin: 0;
    padding: 0 12px;
    border: 1px solid #21533F;
    border-radius: 8px;
    background-color: #FFFFFF;
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
  }

  .homepage-reviews-slider__action-row .homepage-reviews-slider__button:hover {
    background-color: #1f8a81;
    border-color: #1f8a81;
    color: #FBFBFB;
  }

  /* "Review us on Google": same box as the Trustpilot button, same text style */
  .homepage-reviews-slider__google {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    width: 184px;
    height: 38px;
    padding: 0 8px;
    border: 1px solid #21533F;
    border-radius: 8px;
    background-color: #FFFFFF;
    color: #191919;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.2s ease;
  }

  .homepage-reviews-slider__google:hover {
    background-color: #F2F3F2;
    color: #191919;
  }

  .homepage-reviews-slider__google svg {
    width: 16px;
    height: 16px;
    flex: 0 0 16px;
  }

  .homepage-reviews-slider__google-word {
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.2px;
  }

  /* The TrustBox is 240px wide but its button is 184px and centered in it:
     the negative side margins make the visible gap between the buttons 16px */
  .homepage-reviews-slider__action-row .homepage-reviews-slider__trustpilot {
    width: 240px;
    flex: 0 0 240px;
    margin: 0 -28px;
  }

  /* Star color for the review cards */
  .homepage-reviews-slider__star-rating svg,
  .homepage-reviews-slider__star-rating svg path {
    fill: #E8A317 !important;
    color: #E8A317 !important;
  }
</style>

<section
  class="homepage-reviews-slider"
  data-section-id="{{ section.id }}"
  data-section-type="homepage-reviews-slider"
  style="
    --homepage-reviews-slider-padding-top-desktop: {{ section.settings.section_padding_top_desktop }}px;
    --homepage-reviews-slider-padding-bottom-desktop: {{ section.settings.section_padding_bottom_desktop }}px;
    --homepage-reviews-slider-padding-top-mobile: {{ section.settings.section_padding_top_mobile }}px;
    --homepage-reviews-slider-padding-bottom-mobile: {{ section.settings.section_padding_bottom_mobile }}px;
    background-color: #FFFFFF;
  "
>
  <div class="homepage-reviews-slider__wrapper">
    <div class="homepage-reviews-slider__inner">
      {% if section.blocks.size > 0 %}
        <div class="carousel-container homepage-reviews-slider__carousel">
          <div class="carousel-track">
            {% for block in section.blocks %}
              <div class="review-slide" {{ block.shopify_attributes }}>
                <div class="homepage-reviews-slider__card">
                  <div class="homepage-reviews-slider__star-rating">
                    {% render 'icon-star' -%}
                    {%- render 'icon-star' -%}
                    {%- render 'icon-star' -%}
                    {%- render 'icon-star' -%}
                    {%- render 'icon-star' %}
                  </div>

                  {% if block.settings.review_title != blank %}
                    <h3 class="homepage-reviews-slider__title">{{ block.settings.review_title }}</h3>
                  {% endif %}

                  {% if block.settings.review_text != blank %}
                    <div class="homepage-reviews-slider__text">{{ block.settings.review_text }}</div>
                  {% endif %}

                  <div class="homepage-reviews-slider__author-details">
                    {% if block.settings.author_image != blank %}
                      {% assign author_img = block.settings.author_image %}
                      <img
                        src="{{ author_img | image_url: width: 40 }}"
                        alt="{{ author_img.alt | default: block.settings.author_name | escape }}"
                        class="homepage-reviews-slider__author-image"
                        width="40"
                        height="40"
                        loading="lazy"
                      >
                    {% endif %}
                    {% if block.settings.author_name != blank %}
                      <p class="homepage-reviews-slider__author-name">
                        {{ block.settings.author_name }}
                        {% if block.settings.is_verified %}
                          {% render 'homepage-reviews-slider-blue-checkmark' %}
                        {% endif %}
                      </p>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      {% else %}
        <div class="placeholder-content">
          {{ 'no_content' | t }}
        </div>
      {% endif %}

      {%- assign show_button = false -%}
      {%- if section.blocks.size > 0 and section.settings.button_link != blank and section.settings.button_label != blank -%}
        {%- assign show_button = true -%}
      {%- endif -%}
      {%- assign google_review_url = section.settings.google_review_url | default: 'https://search.google.com/local/writereview?placeid=ChIJtUN0vK9ykFQRsxSnGU1RHEA' -%}

      {% if show_button or section.settings.show_google or section.settings.show_trustpilot %}
        <div class="homepage-reviews-slider__action-area homepage-reviews-slider__action-row">
          {% if show_button %}
            <a
              href="{{ section.settings.button_link }}"
              class="homepage-reviews-slider__button"
            >
              {{ section.settings.button_label }}
            </a>
          {% endif %}

          {% if section.settings.show_google %}
            <a
              href="{{ google_review_url }}"
              class="homepage-reviews-slider__google"
              target="_blank"
              rel="noopener"
              aria-label="Review us on Google (opens in a new tab)"
            >
              <span>Review us on</span>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
              </svg>
              <span class="homepage-reviews-slider__google-word">Google</span>
            </a>
          {% endif %}

          {% if section.settings.show_trustpilot %}
            <div class="homepage-reviews-slider__trustpilot">
              <!-- TrustBox script -->
              <script type="text/javascript" src="//widget.trustpilot.com/bootstrap/v5/tp.widget.bootstrap.min.js" async></script>
              <!-- End TrustBox script -->
              <!-- TrustBox widget - Review Collector -->
              <div class="trustpilot-widget" data-locale="en-US" data-template-id="56278e9abfbbba0bdcd568bc" data-businessunit-id="61ca05ef409636017d8dc02d" data-style-height="52px" data-style-width="100%" data-token="76f99f4b-0f79-48cc-859c-39acc66bbe25">
                <a href="https://www.trustpilot.com/review/www.salussaunas.com" target="_blank" rel="noopener">Trustpilot</a>
              </div>
              <!-- End TrustBox widget -->
            </div>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

<script src="{{ 'homepage-reviews-carousel.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Homepage Reviews Slider",
  "tag": "section",
  "class": "homepage-reviews-slider-section",
  "max_blocks": 15,
  "settings": [
    {
      "type": "header",
      "content": "Carousel Behavior"
    },
    {
      "type": "checkbox",
      "id": "show_navigation_arrows",
      "label": "Show Navigation Arrows (Desktop Only)",
      "default": true
    },
    {
      "type": "header",
      "content": "Section Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Show me more reviews"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Google"
    },
    {
      "type": "checkbox",
      "id": "show_google",
      "label": "Show Google review button",
      "default": true
    },
    {
      "type": "url",
      "id": "google_review_url",
      "label": "Google review link",
      "info": "Empty = our Google Business write-a-review link."
    },
    {
      "type": "header",
      "content": "Trustpilot"
    },
    {
      "type": "checkbox",
      "id": "show_trustpilot",
      "label": "Show Trustpilot widget",
      "info": "Trustpilot's free Review Collector widget (\"Review us on Trustpilot\"), next to the buttons.",
      "default": true
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "section_padding_top_desktop",
      "label": "Padding Top (Desktop)",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "section_padding_bottom_desktop",
      "label": "Padding Bottom (Desktop)",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "section_padding_top_mobile",
      "label": "Padding Top (Mobile)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_bottom_mobile",
      "label": "Padding Bottom (Mobile)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "review_card",
      "name": "Review Card",
      "settings": [
        {
          "type": "richtext",
          "id": "review_text",
          "label": "Review Text",
          "default": "<p>\"I use it nearly every day and it's completely revolutionized our backyard into a home spa.\"</p>"
        },
        {
          "type": "text",
          "id": "review_title",
          "label": "Review Title (Optional)",
          "default": "Love my Salus Sauna!!!!"
        },
        {
          "type": "image_picker",
          "id": "author_image",
          "label": "Author Image",
          "info": "Profile photo of the reviewer."
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Author Name",
          "default": "Reviewer Name"
        },
        {
          "type": "checkbox",
          "id": "is_verified",
          "label": "Show 'Verified' Checkmark",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Homepage Reviews Slider",
      "blocks": [
        {
          "type": "review_card"
        },
        {
          "type": "review_card"
        },
        {
          "type": "review_card"
        },
        {
          "type": "review_card"
        }
      ]
    }
  ]
}
{% endschema %}