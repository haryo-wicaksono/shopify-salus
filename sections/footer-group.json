        "custom_liquid": "<div id=\"salus-contact-guard\" hidden></div>\n<style>.cc-custom-liquid:has(#salus-contact-guard),.shopify-section:has(#salus-contact-guard){display:none!important}</style>\n<script>\n/* Salus contact-form guard (2026-11-06). Applies to every Shopify contact form on the page.\n   - Hidden honeypot field + minimum time on page: a bot that trips either gets a normal-looking\n     \"thanks\" page and no email is sent.\n   - The Message field is required (v2, 2026-11-06): an empty message can't be sent.\n   - Content checks (template text, gibberish, first name = last name): one of them\n     only adds a \"Spam check\" line to the email; two or more block the submission.\n   Forms that post to an n8n webhook (data-webhook) are skipped: they have their own checks. */\n(function () {\n  if (window.__salusContactGuard) return;\n  window.__salusContactGuard = true;\n  var LOADED = Date.now();\n  var MIN_MS = 3000;\n  var HP = 'contact[Company website]';\n  var FLAG = 'contact[Spam check]';\n\n  function isContact(f) {\n    return f && f.tagName === 'FORM' &&\n      /^\\/contact(?=$|[#?\\/])/.test(f.getAttribute('action') || '') &&\n      f.elements.form_type && f.elements.form_type.value === 'contact' &&\n      !f.hasAttribute('data-webhook');\n  }\n\n  function arm(f) {\n    var t = f.querySelector('textarea');\n    if (t) t.required = true;\n    if (f.querySelector('[data-sg-hp]')) return;\n    var w = document.createElement('div');\n    w.setAttribute('data-sg-hp', '');\n    w.setAttribute('aria-hidden', 'true');\n    w.style.cssText = 'position:absolute!important;left:-10000px!important;top:auto!important;width:1px!important;height:1px!important;overflow:hidden!important;';\n    w.innerHTML = '<label>Leave this field empty <input type=\"text\" name=\"' + HP + '\" tabindex=\"-1\" autocomplete=\"off\" value=\"\"></label>';\n    f.appendChild(w);\n  }\n\n  function field(f, re) {\n    var els = f.querySelectorAll('input[name^=\"contact[\"],textarea[name^=\"contact[\"]');\n    for (var i = 0; i < els.length; i++) if (re.test(els[i].name)) return (els[i].value || '').trim();\n    return '';\n  }\n\n  function gibberish(s) {\n    var letters = s.replace(/[^a-z]/gi, '');\n    if (letters.length < 8) return false;\n    var vowels = (letters.match(/[aeiou]/gi) || []).length;\n    var words = s.trim().split(/\\s+/).length;\n    return (vowels / letters.length < 0.25 && words <= 3) || /(.)\\1{3,}/i.test(letters);\n  }\n\n  function reasons(f) {\n    var first = field(f, /first\\s*name/i).toLowerCase();\n    var last = field(f, /last\\s*name/i).toLowerCase();\n    var msg = (f.querySelector('textarea') || {}).value || '';\n    msg = msg.trim();\n    var r = [];\n    if (/please\\s+send\\s+(me\\s+)?(some\\s+)?info(rmation)?\\s+to\\s+my\\s+(e-?mail|inbox)/i.test(msg)) r.push('template message');\n    if (msg && gibberish(msg)) r.push('gibberish message');\n    if (first && first === last) r.push('first name = last name');\n    return r;\n  }\n\n  function fakeSuccess(f) {\n    var u = new URL(window.location.href);\n    u.searchParams.set('contact_posted', 'true');\n    u.hash = f.id || '';\n    window.location.assign(u.toString());\n  }\n\n  function armAll() {\n    var forms = document.querySelectorAll('form');\n    for (var i = 0; i < forms.length; i++) if (isContact(forms[i])) arm(forms[i]);\n  }\n  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', armAll);\n  else armAll();\n  document.addEventListener('focusin', function (e) {\n    var f = e.target && e.target.form;\n    if (isContact(f)) arm(f);\n  }, true);\n\n  document.addEventListener('submit', function (e) {\n    var f = e.target;\n    if (!isContact(f)) return;\n    arm(f);\n    var hp = f.querySelector('input[name=\"' + HP + '\"]');\n    var r = reasons(f);\n    var bot = (hp && hp.value.trim() !== '') || (Date.now() - LOADED < MIN_MS) || r.length >= 2;\n    if (bot) {\n      e.preventDefault();\n      e.stopImmediatePropagation();\n      fakeSuccess(f);\n      return;\n    }\n    var t = f.querySelector('textarea');\n    if (t && !t.value.trim()) {\n      e.preventDefault();\n      e.stopImmediatePropagation();\n      t.value = '';\n      if (t.reportValidity) t.reportValidity(); else t.focus();\n      return;\n    }\n    if (hp) hp.disabled = true; // keeps \"Company website:\" out of the email\n    var flag = f.querySelector('input[name=\"' + FLAG + '\"]');\n    if (r.length) {\n      if (!flag) {\n        flag = document.createElement('input');\n        flag.type = 'hidden';\n        flag.name = FLAG;\n        f.appendChild(flag);\n      }\n      flag.value = 'Suspicious (' + r.join(', ') + ')';\n    } else if (flag) {\n      flag.remove();\n    }\n  }, true);\n})();\n</script>",
