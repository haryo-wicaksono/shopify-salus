{%- liquid
  assign form_id = section.id | append: '-contact'
-%}

<section class="detail-contact-form">
  <div class="container">
    <div class="detail-form-row">
      <div class="form-content">
        {% if section.settings.title != blank %}
          <h2>{{ section.settings.title }}</h2>
        {% endif %}

        <div class="contact-details-row">
          {% if section.settings['contact-detail01'] != blank %}
            <div class="contact-detail">
              {{ section.settings['contact-detail01'] }}
            </div>
          {% endif %}
          {% if section.settings['contact-detail02'] != blank %}
            <div class="contact-detail">
              {{ section.settings['contact-detail02'] }}
            </div>
          {% endif %}
          {% if section.settings['contact-detail03'] != blank %}
            <div class="contact-detail">
              {{ section.settings['contact-detail03'] }}
            </div>
          {% endif %}
          {% if section.settings['contact-detail04'] != blank %}
            <div class="contact-detail">
              {{ section.settings['contact-detail04'] }}
            </div>
          {% endif %}
        </div>
        {% if section.settings.note != blank %}
          <div class="note">
            <span>{{ section.settings.note }}</span>
          </div>
        {% endif %}
      </div>
      <div class="Contact_form">
        <div class="form-title">
          <img src="{{ section.settings.icon | img_url:'master'}}" alt="">
          <h3>{{ section.settings['contact-title'] }}</h3>
        </div>

        {%- form 'contact', id: form_id, class: 'form reading-width' -%}
          <div
            class="form__grid grid grid-cols-2 gap-x-theme gap-y-6"
            {% if settings.animations_enabled != 'disabled' %}
              data-cc-animate
            {% endif %}
          >
            {%- for block in section.blocks -%}
              <div
                class="col-span-2{% if block.settings.half_width %} md:col-span-1{% endif %}{% if block.settings.required %} is-required{% endif %}"
                {{ block.shopify_attributes }}
              >
                {%- case block.type -%}
                    <div>
                  {%- when 'first-name' -%}
                    <label class="label" for="{{ form_id }}-first-name">Your Name</label>
                    <input
                      type="text"
                      class="input w-full"
                      id="{{ form_id }}-first-name"
                      name="contact[{{ 'contact.form.first-name' | t }}]"
                      autocomplete="first-name"
                      placeholder="{{ 'contact.form.first-name' | t }}"
                      value="{% if form.first-name %}{{ form.first-name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                      {%- if block.settings.required %}
                        aria-required="true"
                        required
                      {%- endif %}
                    >

                  {%- when 'last-name' -%}
                    <input
                      type="text"
                      class="input w-full"
                      id="{{ form_id }}-first-name"
                      name="contact[{{ 'contact.form.last-name' | t }}]"
                      autocomplete="last-name"
                      placeholder="{{ 'contact.form.last-name' | t }}"
                      value="{% if form.last-name %}{{ form.last-name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                      {%- if block.settings.required %}
                        aria-required="true"
                        required
                      {%- endif %}
                    >

                    </div>
                  {%- when 'email' -%}
                    <label class="label" for="{{ form_id }}-email">{{ 'contact.form.email' | t }}</label>
                    <input
                      type="email"
                      class="input w-full"
                      id="{{ form_id }}-email"
                      name="contact[email]"
                      autocomplete="email"
                      placeholder="i.e. johndoe@email.com"
                      value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                      {%- if form.errors contains 'email' %}
                        aria-invalid="true"
                        aria-describedby="{{ form_id }}-email-error"
                      {%- endif %}
                      {%- if block.settings.required %}
                        aria-required="true"
                        required
                      {%- endif %}
                    >

                  {%- when 'phone' -%}
                    <label class="label" for="{{ form_id }}-phone">{{ 'contact.form.phone' | t }}</label>

                    <input
                      type="tel"
                      class="input w-full"
                      id="{{ form_id }}-phone"
                      name="contact[{{ 'contact.form.phone' | t }}]"
                      pattern="[0-9\-]*"
                      autocomplete="tel"
                      placeholder=""
                      value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                      {%- if block.settings.required %}
                        aria-required="true"
                        required
                      {%- endif %}
                    >

                  {%- when 'body' -%}
                    <label class="label" for="{{ form_id }}-body">{{ 'contact.form.message' | t }}</label>
                    <textarea
                      class="input w-full"
                      id="{{ form_id }}-body"
                      name="contact[{{ 'contact.form.message' | t }}]"
                      placeholder="Let us know how we can help"
                      rows="8"
                      {%- if block.settings.required %}
                        aria-required="true"
                        required
                      {%- endif -%}
                    >
                  {{- form.body -}}
                </textarea>
                  {% when 'social_handles' %}
                    <div class="social-handles-wrapper is-required">
                      <label class="label">{{ block.settings.social_label }}</label>
                      <div class="social_handle">
                        <span class="social-icon">
                          {%- render 'icon-instagram' -%}
                        </span>
                        <input
                          type="url"
                          class="input w-full"
                          id="{{ form_id }}-instagram"
                          name="contact[instagram_link]"
                          placeholder="Enter Instagram Link"
                          value=""
                          {%- if block.settings.insta_required %}
                            aria-required="true"
                            required
                          {%- endif %}
                        >
                      </div>

                      <div class="social_handle">
                        <span class="social-icon">
                          {%- render 'icon-facebook' -%}
                        </span>
                        <input
                          type="url"
                          class="input w-full"
                          id="{{ form_id }}-facebook"
                          name="contact[facebook_link]"
                          placeholder="Enter Facebook Link"
                          value=""
                          {%- if block.settings.facebook_required %}
                            aria-required="true"
                            required
                          {%- endif %}
                        >
                      </div>

                      <div class="social_handle">
                        <span class="social-icon">
                          {%- render 'icon-tiktok' -%}
                        </span>
                        <input
                          type="url"
                          class="input w-full"
                          id="{{ form_id }}-tiktok"
                          name="contact[tiktok_link]"
                          placeholder="Enter TikTok Link"
                          value=""
                          {%- if block.settings.tiktok_required %}
                            aria-required="true"
                            required
                          {%- endif %}
                        >
                      </div>
                      <div class="social_handle">
                        <span class="social-icon">
                          {%- render 'icon-youtube' -%}
                        </span>
                        <input
                          type="url"
                          class="input w-full"
                          id="{{ form_id }}-youtube"
                          name="contact[youtube_link]"
                          placeholder="Enter Youtube Link"
                          value=""
                          {%- if block.settings.tiktok_required %}
                            aria-required="true"
                            required
                          {%- endif %}
                        >
                      </div>
                      <div class="social_handle">
                        <span class="social-icon">
                          {%- render 'icon-globe' -%}
                        </span>
                        <input
                          type="url"
                          class="input w-full"
                          id="{{ form_id }}-personal-site"
                          name="contact[personal_site_link]"
                          placeholder="Enter personal website Link"
                          value=""
                          {%- if block.settings.personal_web_link_required %}
                            aria-required="true"
                            required
                          {%- endif %}
                        >
                      </div>
                    </div>

                  {%- when 'custom' -%}
                    {%- if block.settings.title != blank -%}
                      {%- assign field_handle = block.settings.title | handleize -%}
                      <label class="label" for="{{ form_id }}-field-{{ forloop.index }}">
                        {{- block.settings.title -}}
                      </label>
                      {%- if block.settings.type == 'textarea' -%}
                        <textarea
                          class="input w-full"
                          id="{{ form_id }}-field-{{ forloop.index }}"
                          name="contact[{{ field_handle }}]"
                          rows="8"
                          {%- if block.settings.required %}
                            aria-required="true"
                            required
                          {%- endif -%}
                        >
                      {{- form[field_handle] -}}
                    </textarea>
                      {%- else -%}
                        <input
                          type="{{ block.settings.type }}"
                          class="input w-full"
                          id="{{ form_id }}-field-{{ forloop.index }}"
                          name="contact[{{ field_handle }}]"
                          value="{{ form[field_handle] }}"
                          {% if block.settings.placeholder %}
                            placeholder="{{ block.settings.placeholder }}"
                          {%- endif -%}
                          {%- if block.settings.type == 'tel' %}
                            pattern="[0-9\-]*"
                          {% endif %}
                          {%- if block.settings.required %}
                            aria-required="true"
                            required
                          {%- endif %}
                        >
                      {%- endif -%}
                    {%- endif -%}

                  {%- when 'newsletter' -%}
                    <label class="cwf-newsletter" for="{{ form_id }}-newsletter">
                      <input
                        type="checkbox"
                        class="cwf-newsletter__input"
                        id="{{ form_id }}-newsletter"
                        name="contact[Newsletter]"
                        value="Yes"
                        data-klaviyo-list="{{ block.settings.klaviyo_list_id | strip | escape }}"
                      >
                      <span class="cwf-newsletter__box" aria-hidden="true"></span>
                      <span class="cwf-newsletter__text">{{ block.settings.label | default: 'Subscribe to our newsletter for news and exclusive offers' }}</span>
                    </label>

                  {%- when 'dropdown' -%}
                    {%- if block.settings.title != blank -%}
                      {%- liquid
                        assign field_handle = block.settings.title | handleize
                        assign field_options = block.settings.options | newline_to_br | strip_newlines | split: '<br />'
                        assign native_name = 'contact[' | append: field_handle | append: ']'
                        assign selected_value = form[field_handle] | default: field_options.first
                      -%}
                      <label class="label" for="{{ form_id }}-field-{{ forloop.index }}">
                        {{- block.settings.title -}}
                      </label>
                      <div class="select relative">
                        <select
                          class="w-full input"
                          name="{{ native_name }}"
                          id="{{ form_id }}-field-{{ forloop.index }}"
                        >
                          {% for option in field_options %}
                            <option
                              value="{{ option | escape }}"
                              {% if option == selected_value %}
                                selected
                              {% endif %}
                            >
                              {{ option }}
                            </option>
                          {% endfor %}
                        </select>
                      </div>
                    {%- endif -%}

                  {%- when 'text' -%}
                    {%- if block.settings.text != blank -%}
                      <div class="w-full rte">
                        {{ block.settings.text }}
                      </div>
                    {%- endif -%}

                  {%- when 'radio' -%}
                    {%- liquid
                        assign field_handle = block.settings.title | handleize
                        assign field_options = block.settings.options | newline_to_br | strip_newlines | split: '<br />'
                        assign native_name = 'contact[' | append: field_handle | append: ']'
                    -%}
                    {%- if block.settings.title != blank -%}
                      <label class="label" for="{{ form_id }}-radio-{{ forloop.index }}">
                        {{- block.settings.title -}}
                      </label>
                      
                      <div class="form-radio">
                        <ul role="list">
                          {%- for option in field_options -%}
                              <li class="radio-item">
                                <input type="radio"
                                        class="checkbox js-drawer-sort-by"
                                        id="{{ form_id }}-radio-{{ forloop.index }}"
                                        name="{{ native_name }}"
                                        value="{{ option | escape }}"
                                        {%- if block.settings.required %}
                                          aria-required="true"
                                          required
                                        {%- endif %}>
                                <label for="{{ form_id }}-radio-{{ forloop.index }}" class="flex items-start w-full m-0">
                                  <span class="flex-auto" style="font-weight: 600;">{{- option | escape -}}</span>
                                </label>
                              </li>         
                          {%- endfor -%}
                        </ul>
                      </div>
                    {% endif %}
                    
                
                {%- endcase -%}

                {%- if form.errors contains block.type -%}
                  <p class="form__field-error" id="{{ form_id }}-{{ block.type }}-error">
                    {{ form.errors.translated_fields[block.type] | capitalize }}
                    {{ form.errors.messages[block.type] }}
                  </p>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>

          {%- if form.posted_successfully? -%}
            <div
              class="alert mt-8 bg-success-bg text-success-text"
              tabindex="-1"
              autofocus
              {% if settings.animations_enabled != 'disabled' %}
                data-cc-animate
              {% endif %}
            >
              {{ 'contact.form.post_success' | t }}
            </div>
          {%- elsif form.errors -%}
            <div
              class="alert mt-8 bg-error-bg text-error-text"
              tabindex="-1"
              autofocus
              {% if settings.animations_enabled != 'disabled' %}
                data-cc-animate
              {% endif %}
            >
              <h2 class="h5 text-current">{{ 'contact.form.error_heading' | t }}</h2>
              <ul class="styled-list">
                <li>
                  <a class="link text-current" href="#{{ form_id }}-email">
                    {{- form.errors.translated_fields.email | capitalize }}
                    {{ form.errors.messages.email -}}
                  </a>
                </li>
              </ul>
            </div>
          {%- endif -%}

          {%- if section.blocks.size > 0 -%}
            <div
              class="mt-6"
              {% if settings.animations_enabled != 'disabled' %}
                data-cc-animate
              {% endif %}
            >
              <button class="{{ section.settings.button_style }} w-full md:w-auto">
                {% if section.settings.submit_btn_label == blank -%}
                  Send it to our experts
                {%- else -%}
                  {{- section.settings.submit_btn_label -}}
                {%- endif %}
              </button>
            </div>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{%- if section.blocks.size > 0 -%}
  {%- assign has_newsletter = false -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'newsletter' -%}{%- assign has_newsletter = true -%}{%- endif -%}
  {%- endfor -%}
  {%- if has_newsletter -%}
    <style>
      .detail-contact-form .cwf-newsletter{position:relative;display:flex;align-items:flex-start;gap:12px;margin:0;cursor:pointer;font-family:var(--custom-body-font);font-size:15px;font-weight:400;line-height:1.5;color:#222120}
      .detail-contact-form .cwf-newsletter__input{position:absolute;top:2px;left:0;width:20px;height:20px;margin:0;opacity:0;cursor:pointer}
      .detail-contact-form .cwf-newsletter__box{position:relative;flex:0 0 20px;width:20px;height:20px;margin-top:1px;border:1.5px solid #b4b4b4;border-radius:5px;background:#fff;transition:background-color .15s ease,border-color .15s ease}
      .detail-contact-form .cwf-newsletter__box::after{content:"";position:absolute;left:6px;top:2px;width:5px;height:10px;border:solid #fff;border-width:0 2px 2px 0;transform:rotate(45deg);opacity:0;transition:opacity .15s ease}
      .detail-contact-form .cwf-newsletter:hover .cwf-newsletter__box{border-color:#1b413e}
      .detail-contact-form .cwf-newsletter__input:checked + .cwf-newsletter__box{background:#1b413e;border-color:#1b413e}
      .detail-contact-form .cwf-newsletter__input:checked + .cwf-newsletter__box::after{opacity:1}
      .detail-contact-form .cwf-newsletter__input:focus-visible + .cwf-newsletter__box{outline:2px solid #1b413e;outline-offset:2px}
    </style>
    <script>
      /* Newsletter checkbox on the Contact Sales form: when it is ticked, the email is added to the
         Klaviyo list set on the block before the form is sent. The message itself still goes out
         through Shopify's contact form as before (with an extra "Newsletter: Yes" line). */
      (function () {
        if (window.__salusFormNewsletter) return;
        window.__salusFormNewsletter = true;
        var KLAVIYO_COMPANY = 'UsSdxi';
        var LOADED = Date.now();
        var EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
        function val(f, sel) { var el = f.querySelector(sel); return el ? String(el.value || '').trim() : ''; }
        function subscribe(f, box) {
          var body = {
            data: {
              type: 'subscription',
              attributes: {
                custom_source: 'Contact Sales form',
                profile: { data: { type: 'profile', attributes: {
                  email: val(f, 'input[name="contact[email]"]'),
                  first_name: val(f, 'input[name="contact[First name]"]') || undefined,
                  last_name: val(f, 'input[name="contact[Last name]"]') || undefined
                } } }
              },
              relationships: { list: { data: { type: 'list', id: box.getAttribute('data-klaviyo-list') } } }
            }
          };
          var ctrl = window.AbortController ? new AbortController() : null;
          var timer = setTimeout(function () { if (ctrl) ctrl.abort(); }, 4000);
          return fetch('https://a.klaviyo.com/client/subscriptions?company_id=' + KLAVIYO_COMPANY, {
            method: 'POST',
            headers: { 'Content-Type': 'application/vnd.api+json', 'revision': '2024-10-15' },
            body: JSON.stringify(body),
            keepalive: true,
            signal: ctrl ? ctrl.signal : undefined
          }).then(function (r) { f.dataset.newsletter = r.ok ? 'subscribed' : 'error ' + r.status; })
            .catch(function () { f.dataset.newsletter = 'error'; })
            .then(function () { clearTimeout(timer); });
        }
        // Capture phase: runs before the spam guard and Shopify's captcha, so the form can wait
        // for Klaviyo and then go through the normal submit path again.
        window.addEventListener('submit', function (e) {
          var f = e.target;
          if (!f || !f.querySelector) return;
          var box = f.querySelector('input.cwf-newsletter__input');
          if (!box || !box.checked || f.dataset.newsletterDone) return;
          if (f.dataset.newsletterPending) { e.preventDefault(); e.stopImmediatePropagation(); return; }
          var email = val(f, 'input[name="contact[email]"]');
          var hp = f.querySelector('input[name="contact[Company website]"]');
          var msg = f.querySelector('textarea');
          if (!box.getAttribute('data-klaviyo-list') || !EMAIL.test(email) ||
              (hp && hp.value.trim()) || Date.now() - LOADED < 3000 || (msg && !msg.value.trim())) return;
          e.preventDefault();
          e.stopImmediatePropagation();
          var submitter = e.submitter || null;
          f.dataset.newsletterPending = '1';
          subscribe(f, box).then(function () {
            delete f.dataset.newsletterPending;
            f.dataset.newsletterDone = '1';
            if (f.requestSubmit) { try { f.requestSubmit(submitter && submitter.form === f ? submitter : undefined); return; } catch (err) {} }
            f.submit();
          });
        }, true);
      })();
    </script>
  {%- endif -%}
{%- endif -%}

