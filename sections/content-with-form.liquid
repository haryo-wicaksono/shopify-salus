        "id": "half_width",
        "label": "Half width on large screens",
        "default": false
      }
    ]
  },
  {
    "type": "phone",
    "name": "Phone",
    "limit": 1,
    "settings": [
      {
        "type": "checkbox",
        "id": "required",
        "label": "Required",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "half_width",
        "label": "Half width on large screens",
        "default": false
      }
    ]
  },
  {
    "type": "body",
    "name": "Message",
    "limit": 1,
    "settings": [
