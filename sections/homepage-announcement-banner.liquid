{% comment %}
  Announcement banner with optional countdown timer.
{% endcomment %}

<style>
  .announcement-banner {
    background-color: {{ section.settings.background_color }};
    padding: 10px 15px;
    border-bottom: 2px solid #E8E8E8;
  }

  .announcement-banner__content {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 1200px;
    margin: 0 auto;
    font-size: 18px;
    color: {{ section.settings.text_color }};
  }

  .announcement-banner__icon {
    margin-right: 10px;
    width: 13px;
    height: 13px;
    fill: {{ section.settings.text_color }};
  }

  .announcement-banner__text a {
    color: {{ section.settings.text_color }};
    text-decoration: none;
    font-weight: bold;
  }

  .announcement-banner__text a:hover {
    text-decoration: underline;
  }

  .announcement-banner__text {
    margin-bottom: 0px;
  }

  .sale-countdown {
    display: inline-flex;
    gap: 6px;
    margin-left: 12px;
    font-weight: bold;
  }

  .sale-countdown__unit {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
  }

  .sale-countdown__number {
    font-size: 1.1em;
    font-weight: 900;
  }

  .sale-countdown__label {
    font-size: 0.55em;
    opacity: 0.85;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .sale-countdown__sep {
    font-weight: 900;
    opacity: 0.6;
    align-self: flex-start;
    padding-top: 1px;
  }

  @media screen and (max-width: 769px) {
    .announcement-banner__text {
      font-size: 14px;
    }
    .sale-countdown {
      gap: 4px;
      margin-left: 8px;
    }
  }
</style>

{% if section.settings.show_banner %}
  <div class="announcement-banner">
    <div class="announcement-banner__content">
      <p class="announcement-banner__text">
        {{ section.settings.text | escape }}
        <a href="tel:{{ section.settings.phone_number | escape }}">{{ section.settings.phone_number | escape }}</a>
        <span class="sale-countdown" id="sale-countdown" style="display:none;">
          <span class="sale-countdown__unit">
            <span class="sale-countdown__number" id="cd-days">0</span>
            <span class="sale-countdown__label">days</span>
          </span>
          <span class="sale-countdown__sep">:</span>
          <span class="sale-countdown__unit">
            <span class="sale-countdown__number" id="cd-hours">00</span>
            <span class="sale-countdown__label">hours</span>
          </span>
          <span class="sale-countdown__sep">:</span>
          <span class="sale-countdown__unit">
            <span class="sale-countdown__number" id="cd-mins">00</span>
            <span class="sale-countdown__label">min</span>
          </span>
          <span class="sale-countdown__sep">:</span>
          <span class="sale-countdown__unit">
            <span class="sale-countdown__number" id="cd-secs">00</span>
            <span class="sale-countdown__label">sec</span>
          </span>
        </span>
      </p>
    </div>
  </div>

  <script>
    (function () {
      var TARGET = new Date('2026-08-10T23:59:59');
      var wrap = document.getElementById('sale-countdown');
      var dEl  = document.getElementById('cd-days');
      var hEl  = document.getElementById('cd-hours');
      var mEl  = document.getElementById('cd-mins');
      var sEl  = document.getElementById('cd-secs');

      function pad(n) { return n < 10 ? '0' + n : '' + n; }

      function tick() {
        var diff = TARGET - Date.now();
        if (diff <= 0) { wrap.style.display = 'none'; return; }
        var d = Math.floor(diff / 86400000);
        var h = Math.floor((diff % 86400000) / 3600000);
        var m = Math.floor((diff % 3600000) / 60000);
        var s = Math.floor((diff % 60000) / 1000);
        dEl.textContent = d;
        hEl.textContent = pad(h);
        mEl.textContent = pad(m);
        sEl.textContent = pad(s);
        wrap.style.display = 'inline-flex';
      }

      tick();
      setInterval(tick, 1000);
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Announcement Banner",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_banner",
      "label": "Show banner",
      "default": false
    },
    {
      "type": "text",
      "id": "text",
      "label": "Announcement text",
      "default": "Have questions? Give us a call"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Phone number",
      "default": "(888) 287-0111"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Homepage Announcement Banner"
    }
  ]
}
{% endschema %}