<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Kaushan+Script&family=Playfair+Display:ital,wght@1,800&display=swap">
<style>

.bf-root{--ink:#1f3a33;--ink2:#2e5148;--body:#3f4f48;--muted:#5f6e67;--mark:#b23a2e;--sage:#eef2eb;--sage2:#e2e8de;--sage3:#d3dccd;--line:#c3cdbf;--paper:#ffffff;--tbd:rgba(242,215,91,.55);} .bf-root *{box-sizing:border-box;} .bf-root{margin:0;background:var(--paper);color:var(--body);font-family:'Poppins',Helvetica,Arial,sans-serif;font-weight:400;font-size:16px;line-height:1.6;font-variant-numeric:lining-nums;-webkit-font-smoothing:antialiased;} .bf-root a{color:inherit;} .bf-root img{max-width:100%;display:block;}
.bf-in{max-width:1240px;margin:0 auto;padding:0 40px;} .bf-root h1,.bf-root h2,.bf-root h3{color:var(--ink);margin:0;font-weight:700;letter-spacing:-.01em;line-height:1.12;}
.bf-hl{font-family:'Playfair Display',Georgia,serif;font-style:italic;font-weight:800;font-size:1.08em;letter-spacing:0;} .bf-root mark.bf-tbd{background:var(--tbd);color:inherit;padding:0 .2em;border-radius:3px;}
.bf-btn{display:inline-flex;align-items:center;gap:.55em;border-radius:999px;padding:14px 28px;font-weight:500;font-size:16px;text-decoration:none;border:2px solid var(--ink);transition:background-color .15s,color .15s;}
.bf-btn.bf-pri{background:var(--ink);color:#fff;} .bf-btn.bf-pri:hover{background:var(--ink2);border-color:var(--ink2);}
.bf-btn.bf-sec{background:transparent;color:var(--ink);} .bf-btn.bf-sec:hover{background:var(--ink);color:#fff;}
.bf-btn:focus-visible,.bf-tile:focus-visible,summary:focus-visible{outline:3px solid var(--mark);outline-offset:3px;}
.bf-btns{display:flex;flex-wrap:wrap;gap:12px;}

/* site chrome */
.bf-top{border-bottom:1px solid #ececec;background:#fff;}
.bf-top .bf-in{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;height:84px;font-size:13px;color:#333;letter-spacing:.02em;}
.bf-top nav{display:flex;gap:18px;} .bf-top nav a{text-decoration:none;}
.bf-top .bf-logo img{height:30px;}
.bf-top .bf-tools{text-align:right;color:var(--muted);}
.bf-bar{background:var(--ink);color:#fff;text-align:center;font-size:13.5px;padding:9px 16px;letter-spacing:.01em;}

/* hero */
.bf-hero{position:relative;background:var(--sage) url('https://cdn.shopify.com/s/files/1/0720/7695/1854/files/black-friday-2026-banner-desktop.jpg?v=1795107862&width=2400') center 62%/cover no-repeat;aspect-ratio:16/8;max-height:780px;min-height:560px;width:100%;}
.bf-hero .bf-in{position:absolute;inset:0;max-width:none;padding:0;}
.bf-hero .bf-copy{position:absolute;inset:0;}
.bf-hero .bf-rev{position:absolute;top:5%;left:0;right:0;justify-content:center;margin:0;}
.bf-hero h1{position:absolute;top:10%;left:0;right:0;text-align:center;white-space:nowrap;}
.bf-hero .bf-line{position:absolute;left:6%;bottom:calc(8% + 8px);margin:0;font-size:26px;}
.bf-hero p.bf-sub{display:none;}
.bf-hero .bf-btns{position:absolute;right:6%;bottom:8%;}
.bf-rev{display:flex;align-items:center;gap:10px;font-size:14px;font-weight:500;color:var(--ink);margin:0 0 18px;}
.bf-stars{color:#1f8a81;letter-spacing:.14em;font-size:15px;}
.bf-hero h1{font-size:clamp(46px,6.6vw,104px);}
.bf-line{position:relative;display:inline-block;margin:14px 0 22px;font-size:30px;font-weight:500;color:var(--ink);}
.bf-line em{position:relative;font-style:normal;white-space:nowrap;}
.bf-under{position:absolute;left:-2%;bottom:-.28em;width:104%;height:.42em;overflow:visible;}
.bf-under path{fill:none;stroke:var(--mark);stroke-width:3;stroke-linecap:round;vector-effect:non-scaling-stroke;}
.bf-hero p.bf-sub{font-size:18px;color:var(--body);margin:0 0 30px;max-width:30em;}

/* countdown */
.bf-cd{background:var(--ink);color:#fff;}
.bf-cd .bf-in{display:flex;align-items:center;justify-content:center;gap:14px;padding:12px 24px;flex-wrap:wrap;}
.bf-cdl{font-size:15px;font-weight:500;letter-spacing:.01em;margin-right:6px;}
.bf-cdu{display:inline-flex;align-items:baseline;gap:4px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.18);border-radius:8px;padding:5px 10px;}
.bf-cdu b{font-size:20px;font-weight:700;font-variant-numeric:tabular-nums;min-width:1.3em;text-align:center;}
.bf-cdu small{font-size:12px;color:#c9d6cf;}
/* free accessories */
.bf-gift{background:var(--ink);color:#fff;padding:44px 0 48px;}
.bf-gift h2{color:#fff;font-size:30px;margin:0 0 24px;text-align:center;}
.bf-gifts{display:flex;flex-wrap:wrap;justify-content:center;gap:20px;max-width:860px;margin:0 auto;} .bf-gifts .bf-gc{flex:0 1 calc(50% - 10px);box-sizing:border-box;}
.bf-gc{display:flex;align-items:center;min-height:116px;gap:20px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.16);border-radius:14px;padding:16px 22px;}
.bf-gc img{width:104px;height:84px;object-fit:contain;flex:0 0 auto;filter:drop-shadow(0 6px 8px rgba(0,0,0,.35));}
.bf-gc .bf-two{display:flex;flex:0 0 auto;width:104px;} .bf-gc .bf-two img{width:68px;height:84px;} .bf-gc .bf-two img+img{margin-left:-32px;transform:translateY(6px);}
.bf-gc p{margin:0;display:flex;flex-direction:column;} .bf-gc b{font-size:18px;font-weight:600;} .bf-gc span{color:#c9d6cf;font-size:15px;}
.bf-perks{background:var(--sage);border-bottom:1px solid var(--line);}
.bf-perks ul{list-style:none;margin:0;padding:22px 0;display:grid;grid-template-columns:repeat(4,1fr);gap:16px;}
.bf-perks li{display:flex;flex-direction:column;line-height:1.35;padding-left:14px;border-left:2px solid var(--line);}
.bf-perks b{color:var(--ink);font-weight:600;font-size:15px;} .bf-perks span{color:var(--muted);font-size:13.5px;}
/* sections */
section.bf-blk{padding:96px 0;}
.bf-head{max-width:640px;margin:0 0 44px;}
.bf-head h2{font-size:42px;margin-bottom:14px;}
.bf-head p{margin:0;font-size:17px;}
#shop{background:#fff;}
.bf-how{list-style:none;margin:-16px 0 44px;padding:0;display:grid;grid-template-columns:1fr auto 1fr auto 1fr;align-items:center;gap:12px;}
.bf-how li{display:flex;align-items:center;gap:16px;background:var(--sage);border:1px solid var(--line);border-radius:16px;padding:18px 20px;height:100%;}
.bf-how li.bf-plus{background:none;border:0;padding:0;height:auto;justify-content:center;width:34px;font-size:30px;font-weight:700;color:var(--mark);line-height:1;}
.bf-how .bf-sym{flex:0 0 auto;width:54px;height:54px;border-radius:50%;background:var(--ink);color:#fff;display:flex;align-items:center;justify-content:center;font-size:28px;font-weight:700;line-height:1;box-shadow:0 0 0 4px var(--sage),0 0 0 5px var(--line);}
.bf-how .bf-sym svg{width:28px;height:28px;}
.bf-how p{margin:0;display:flex;flex-direction:column;line-height:1.3;}
.bf-how small{font-size:13px;font-weight:500;color:var(--muted);letter-spacing:.01em;}
.bf-how b{color:var(--ink);font-weight:700;font-size:17.5px;}
.bf-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
.bf-tile{display:flex;flex-direction:column;text-decoration:none;color:var(--ink);background:var(--sage);border-radius:14px;overflow:hidden;transition:transform .2s;}
.bf-tile:hover{transform:translateY(-3px);}
@media (prefers-reduced-motion:reduce){.bf-tile{transition:none;} .bf-tile:hover{transform:none;}}
.bf-pic{position:relative;height:280px;display:flex;align-items:flex-end;justify-content:center;padding:28px 28px 0;background:radial-gradient(ellipse at 50% 40%,#f6f8f3 0%,var(--sage2) 60%,var(--sage3) 100%);}
.bf-pic img{height:232px;width:auto;object-fit:contain;filter:drop-shadow(0 10px 12px rgba(0,0,0,.18));}
.bf-pic.bf-wide{align-items:center;padding:28px 30px 12px;} .bf-pic.bf-wide img{width:100%;height:auto;max-height:100%;}
.bf-pic.bf-duo img:first-child{height:226px;margin-right:-26px;} .bf-pic.bf-duo img:last-child{height:150px;position:relative;z-index:1;}
.bf-tname{font-size:20px;font-weight:600;padding:20px 24px 2px;}
.bf-tgo{font-size:14.5px;color:var(--muted);padding:0 24px 22px;}
.bf-tile:hover .bf-tgo{color:var(--ink);}

#sales{background:var(--sage);}
.bf-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
.bf-card{background:#fff;border-radius:14px;padding:30px 28px 30px;border:1px solid var(--line);display:flex;flex-direction:column;}
.bf-card .bf-ci{height:120px;display:flex;align-items:center;margin-bottom:18px;}
.bf-card .bf-ci img{height:112px;width:auto;}
.bf-card .bf-ci.bf-duo img:first-child{height:112px;margin-right:-14px;} .bf-card .bf-ci.bf-duo img:last-child{height:76px;align-self:flex-end;margin-bottom:6px;}
.bf-card .bf-ci svg{width:112px;height:112px;}
.bf-card h3{font-size:21px;margin-bottom:8px;}
.bf-card p{margin:0;}
.bf-contact{display:flex;flex-wrap:wrap;align-items:center;gap:16px 28px;margin-top:40px;padding-top:32px;border-top:1px solid var(--line);}
.bf-contact .bf-k{font-size:14px;color:var(--muted);}
.bf-contact a.bf-t{font-size:22px;font-weight:600;color:var(--ink);text-decoration:none;}
.bf-contact .bf-sep{width:1px;height:36px;background:var(--line);}

#reviews .bf-head{margin-bottom:36px;}
#guide{background:#fff;padding-bottom:0;}
.bf-guides{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;}
.bf-gd{display:flex;flex-direction:column;gap:6px;text-decoration:none;border:1px solid var(--line);border-radius:14px;padding:22px 22px 24px;color:var(--body);}
.bf-gd b{color:var(--ink);font-size:17px;font-weight:600;} .bf-gd span{font-size:14.5px;}
.bf-gd b::after{content:' →';font-weight:400;}
.bf-gd:hover{border-color:var(--ink);}
.bf-rev{flex-wrap:wrap;gap:4px 18px;} .bf-rev .bf-ri{white-space:nowrap;} .bf-rev .bf-stars{letter-spacing:0;}
.bf-scores{display:flex;flex-wrap:wrap;gap:16px;margin:-12px 0 36px;}
.bf-score{display:flex;align-items:center;gap:14px;text-decoration:none;color:var(--ink);background:var(--sage);border-radius:12px;padding:14px 22px 14px 18px;line-height:1.35;}
.bf-score .bf-g{width:30px;height:30px;flex:0 0 auto;}
.bf-score b{font-size:24px;} .bf-score small{font-size:13px;color:var(--muted);}
.bf-score .bf-stars{color:#f5b400;font-size:15px;}
.bf-score:hover{background:var(--sage2);}
.bf-quotes{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;}
.bf-quote{margin:0;background:#fff;border:1px solid var(--line);border-radius:14px;padding:22px 22px 20px;display:flex;flex-direction:column;}
.bf-qs{color:#f5b400;letter-spacing:.1em;font-size:15px;margin-bottom:10px;}
.bf-quote p{font-size:15.5px;color:var(--ink);margin:0 0 16px;flex:1;}
.bf-quote footer{font-size:14px;font-weight:600;color:var(--ink);} .bf-quote footer span{font-weight:400;color:var(--muted);}
.bf-more{margin:28px 0 0;} .bf-more a{color:var(--ink);font-weight:500;}

#faq{background:#fff;padding-top:0;}
#faq .bf-head{text-align:center;margin-left:auto;margin-right:auto;}
.bf-faq{max-width:820px;margin:0 auto;border-top:1px solid var(--line);}
.bf-root details{border-bottom:1px solid var(--line);}
.bf-root summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;gap:20px;padding:22px 2px;font-size:18px;font-weight:600;color:var(--ink);}
.bf-root summary::-webkit-details-marker{display:none;}
.bf-root summary::after{content:'+';font-weight:400;font-size:26px;line-height:1;color:var(--muted);}
.bf-root details[open] summary::after{content:'–';}
.bf-root details p{margin:0 2px 24px;max-width:44em;}

.bf-last{background:var(--ink);color:#fff;text-align:center;padding:88px 0;}
.bf-last h2{color:#fff;font-size:52px;margin-bottom:10px;}
.bf-last p{font-size:19px;margin:0 0 30px;color:#d6e0da;}
.bf-last .bf-btns{justify-content:center;}
.bf-last .bf-btn.bf-pri{background:#fff;color:var(--ink);border-color:#fff;} .bf-last .bf-btn.bf-pri:hover{background:var(--sage);}
.bf-last .bf-btn.bf-sec{color:#fff;border-color:#fff;} .bf-last .bf-btn.bf-sec:hover{background:#fff;color:var(--ink);}
.bf-last .bf-under path{stroke:#e8846f;}
.bf-foot{background:#f6f6f4;color:var(--muted);font-size:13px;}
.bf-foot .bf-in{display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;padding-top:28px;padding-bottom:28px;}

@media (max-width:1279px){
  .bf-hero p.bf-sub{display:none;}
  .bf-hero .bf-line{font-size:22px;}
}
/* tablet */
@media (max-width:1023px){
  .bf-in{padding:0 28px;}
  .bf-hero{min-height:480px;}
  .bf-hero p.bf-sub{display:none;}
  .bf-grid{grid-template-columns:repeat(2,1fr);}
  .bf-cards{grid-template-columns:1fr;} .bf-quotes{grid-template-columns:1fr 1fr;}
  .bf-guides{grid-template-columns:1fr 1fr;} .bf-perks ul{grid-template-columns:1fr 1fr;}
  .bf-card{flex-direction:row;gap:24px;align-items:center;} .bf-card .bf-ci{flex:0 0 140px;margin:0;justify-content:center;}
}
/* phone */
@media (max-width:767px){
  body{font-size:15px;}
  .bf-in{padding:0 18px;}
  .bf-top .bf-in{grid-template-columns:1fr;height:60px;}
  .bf-top nav{display:none;} .bf-top .bf-logo{justify-self:center;} .bf-top .bf-logo img{height:22px;}
  .bf-top .bf-tools{display:none;}
  .bf-bar{font-size:12.5px;}
  .bf-hero{background:#c9d1c2 url('https://cdn.shopify.com/s/files/1/0720/7695/1854/files/black-friday-2026-banner-mobile.jpg?v=1795109291&width=1080') center top/100% auto no-repeat;min-height:0;max-height:none;aspect-ratio:auto;display:block;padding-top:70vw;}
  .bf-hero .bf-in,.bf-hero .bf-copy{position:static;} .bf-hero .bf-in{padding:0 18px;}
  .bf-hero .bf-copy{padding:0 0 40px;text-align:center;}
  .bf-hero .bf-rev,.bf-hero h1,.bf-hero .bf-line,.bf-hero p.bf-sub,.bf-hero .bf-btns{position:static;width:auto;white-space:normal;}
  .bf-hero .bf-rev{justify-content:center;margin:0 0 10px;}
  .bf-hero .bf-line{margin:8px 0 14px;}
  .bf-hero p.bf-sub{display:block;margin:0 0 20px;}
  .bf-rev{font-size:12.5px;margin-bottom:12px;}
  .bf-hero h1{font-size:40px;}
  .bf-line{font-size:22px;margin:10px 0 16px;}
  .bf-hero p.bf-sub{font-size:16px;margin-bottom:22px;}
  .bf-btns .bf-btn{flex:1 1 auto;justify-content:center;}
  .bf-gift .bf-in{font-size:15px;padding-top:14px;padding-bottom:14px;}
  section.bf-blk{padding:64px 0;}
  .bf-head h2{font-size:30px;}
  .bf-head p{font-size:15.5px;}
  .bf-grid{grid-template-columns:1fr 1fr;gap:12px;}
  .bf-how{grid-template-columns:1fr;gap:6px;margin:-8px 0 28px;} .bf-how li.bf-plus{width:auto;font-size:24px;} .bf-how li{padding:14px 16px;} .bf-how .bf-sym{width:46px;height:46px;font-size:24px;} .bf-how b{font-size:16px;}
  .bf-cd .bf-in{gap:8px;padding:10px 12px;} .bf-cdl{width:100%;text-align:center;font-size:13.5px;margin:0;} .bf-cdu{padding:4px 8px;} .bf-cdu b{font-size:17px;}
  .bf-gift{padding:36px 0;} .bf-gift h2{font-size:23px;} .bf-gifts{gap:12px;} .bf-gifts .bf-gc{flex-basis:100%;} .bf-gc{min-height:0;gap:14px;padding:14px 16px;} .bf-gc img{width:80px;height:64px;} .bf-gc .bf-two{width:80px;} .bf-gc .bf-two img{width:54px;height:64px;} .bf-gc .bf-two img+img{margin-left:-28px;}
  .bf-perks ul{gap:14px 10px;padding:18px 0;}
  .bf-guides{grid-template-columns:1fr;}
  .bf-pic{height:170px;padding:16px 12px 0;} .bf-pic img{height:144px;}
  .bf-pic.bf-duo img:first-child{height:96px;margin-right:-8px;} .bf-pic.bf-duo img:last-child{height:62px;}
  .bf-pic img{max-width:none;}
  .bf-tname{font-size:15.5px;padding:14px 14px 0;line-height:1.25;}
  .bf-tgo{font-size:13px;padding:4px 14px 16px;}
  .bf-card{flex-direction:column;align-items:flex-start;gap:0;padding:24px 22px;} .bf-card .bf-ci{flex:none;height:96px;margin-bottom:12px;justify-content:flex-start;} .bf-card .bf-ci img{height:92px;}
  .bf-contact .bf-sep{display:none;}
  .bf-contact a.bf-t{font-size:19px;}
  .bf-root summary{font-size:16px;padding:18px 2px;}
  .bf-quotes{grid-template-columns:1fr;}
  .bf-score{flex:1 1 100%;}
  .bf-last{padding:64px 0;} .bf-last h2{font-size:36px;} .bf-last p{font-size:16px;}
}

.bf-root{font-family:inherit;}
.bf-root .bf-upto{display:block;font-family:'Kaushan Script',cursive;font-weight:400;font-style:normal;color:#C8322B;font-size:clamp(24px,0.4em,46px);line-height:1.15;margin-top:0.08em;transform:rotate(-2deg);letter-spacing:0;}
</style>
