{%- comment -%}
  OPCIONES DE GLOBO: ORDEN Y NOMBRES (6-oct-2026, pedido de Eva y Brandon)
  1. "Freebies" se muestra como "Included with your Order" y va primero.
  2. "Heater Size" se muestra como "Heater Options". Los upgrades quedan en su orden.
  3. Los add-ons van al final.
  4. Dentro de los add-ons, el Bluetooth Sauna Speaker va primero.
  5. Los bloques C2 Exterior Sauna Guard y C2 Exterior Sauna Guard Tints se ocultan (los cubre el Care Essentials Kit).
  Aplica a todos los option sets a la vez, buscando cada bloque por su titulo visible.
  - Para renombrar otro bloque: agregarlo a RENAME ('titulo actual en minusculas': 'Titulo nuevo').
  - Para mandar otro bloque al final: agregar su titulo en minusculas a LAST.
  - Para ocultar otro bloque: agregar su titulo en minusculas a HIDE. Para volver a mostrar los C2: vaciar HIDE.
  - Para subir otro producto al inicio de los add-ons: agregar una palabra de su nombre a PIN_FIRST.
  6. Cold plunges (5-nov-2026, pedido de Brandon): en "Chiller Sizes" se muestra el chiller negro de 1 HP como
     "Standard" (solo de adorno, no se puede elegir) y el 1 HP Premier blanco como "$1,000 FREE UPGRADE".
     El carrito no cambia: sigue entrando el Premier a $0. Para quitarlo: poner CHILLER_UPGRADE = false.
  Para quitarlo: borrar el render en layout/theme.liquid y este snippet.
{%- endcomment -%}
<style>.salus-hide-option { display: none !important; }
.salus-chiller-standard { pointer-events: none; cursor: default; }
.salus-chiller-standard .card-free-badge { color: #6b6b6b; }</style>
<script>
(function () {
  var RENAME = {
    'freebies': 'Included with your Order',
    'heater size': 'Heater Options'
  };
  var FIRST = ['freebies', 'included with your order'];
  var LAST = [
    'add ons', 'accessories', 'waterproof boxes',
    'safety railing', 'huum hive safety rail', 'huum steel safety rail',
    'c2 exterior sauna guard', 'c2 exterior sauna guard tints', '1 x tints', '2 x tints',
    'heat shield', 'heater base', 'select rain barrel jackets color',
    'floor kit', 'floor base'
  ];
  var PIN_FIRST = ['bluetooth'];
  var HIDE = ['c2 exterior sauna guard', 'c2 exterior sauna guard tints'];
  var CHILLER_UPGRADE = true;
  var CHILLER_STD_NAME = '1 HP Chiller System';
  var CHILLER_STD_IMG = 'https://cdn.shopify.com/s/files/1/0720/7695/1854/files/2233.webp?width=120';
  var CHILLER_WAS = '$1,000';

  function upgradeChiller() {
    if (!CHILLER_UPGRADE) return;
    var cards = document.querySelectorAll('.custom-variant-card:not(.salus-chiller-standard)');
    for (var i = 0; i < cards.length; i++) {
      var c = cards[i];
      var t = c.querySelector('.card-title');
      if (!t || !/1 hp premier cold\/heat chiller/i.test(t.textContent)) continue;
      if (c.classList.contains('salus-chiller-upgrade')) continue;
      c.classList.add('salus-chiller-upgrade');
      var b = c.querySelector('.card-free-badge');
      if (b) b.outerHTML = '<div class="card-price-section"><span class="card-price-was">' + CHILLER_WAS +
        '</span><span class="card-save-badge">Free upgrade</span></div>';
      var old = c.parentNode.querySelectorAll('.salus-chiller-standard');
      for (var k = 0; k < old.length; k++) old[k].remove();
      var s = document.createElement('div');
      s.className = 'custom-variant-card salus-chiller-standard';
      s.setAttribute('aria-disabled', 'true');
      s.innerHTML = '<div class="card-main"><div class="card-image-container"><img src="' + CHILLER_STD_IMG +
        '" alt="' + CHILLER_STD_NAME + '" class="card-image"></div><div class="card-content"><div class="card-header-row">' +
        '<div class="card-header-main"><h3 class="card-title">' + CHILLER_STD_NAME + '</h3>' +
        '<div class="card-free-badge">Standard - Included with your order</div></div></div></div></div>';
      c.parentNode.insertBefore(s, c);
    }
  }

  function norm(text) {
    return text.replace(/[^a-z0-9 ]/gi, ' ').replace(/\s+/g, ' ').trim().toLowerCase();
  }

  function pinProducts(block) {
    var items = block.querySelectorAll('.gpo-ov-wrapper > *');
    for (var j = 0; j < items.length; j++) {
      var name = norm(items[j].textContent);
      for (var k = 0; k < PIN_FIRST.length; k++) {
        if (name.indexOf(PIN_FIRST[k]) > -1) {
          if (items[j].style.order !== '-1') items[j].style.order = '-1';
          break;
        }
      }
    }
  }

  function updateBlocks() {
    var blocks = document.querySelectorAll('.gpo-form__group');
    for (var i = 0; i < blocks.length; i++) {
      var el = blocks[i];
      if (el.querySelector('.gpo-form__group')) continue; // grupo contenedor, no un bloque
      var labelEl = el.querySelector('.label-content');
      if (!labelEl) continue;
      var label = norm(labelEl.textContent);
      if (RENAME[label]) {
        labelEl.textContent = RENAME[label];
        label = norm(RENAME[label]);
      }
      if (HIDE.indexOf(label) > -1) { el.classList.add('salus-hide-option'); continue; }
      var isAddOn = LAST.indexOf(label) > -1;
      var order = (el.classList.contains('freebies') || FIRST.indexOf(label) > -1) ? '-1'
        : (isAddOn ? '1' : '');
      if (order && el.style.order !== order) el.style.order = order;
      if (isAddOn) pinProducts(el);
    }
    upgradeChiller();
  }

  var pending = false;
  function schedule() {
    if (pending) return;
    pending = true;
    window.requestAnimationFrame(function () { pending = false; updateBlocks(); });
  }

  document.addEventListener('DOMContentLoaded', schedule);
  new MutationObserver(schedule).observe(document.documentElement, { childList: true, subtree: true });
})();
</script>
