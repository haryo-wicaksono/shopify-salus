lus-ct .step .num{font-size:34px;font-weight:600;color:var(--teal);line-height:1}.salus-ct .step p{font-size:15px;color:var(--muted);margin:0}.salus-ct .alert{margin-top:40px;background:#fff5ec;border-left:4px solid #c9772e;padding:22px 26px;font-size:15px}.salus-ct .alert strong{display:block;margin-bottom:4px}.salus-ct .alert a{color:var(--teal)}\n.salus-ct .contrast{background:var(--cream)}.salus-ct .contrast .duo{display:grid;grid-template-columns:1fr 1fr;gap:0;border:1px solid var(--line)}.salus-ct .duo div{padding:34px}.salus-ct .duo .warm{background:#f3e3d3}.salus-ct .duo .cold{background:#dcecea}.salus-ct .duo h3{margin-top:0}.salus-ct .duo p{font-size:15px;color:var(--muted);margin:0}\n.salus-ct .temp{margin-top:40px;border:1px solid var(--line);background:var(--mist);padding:30px}.salus-ct .temp h3{margin-top:0}.salus-ct .temp-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin:18px 0}.salus-ct .temp-stats strong{display:block;font-size:24px;font-weight:600;color:var(--teal);line-height:1.25}.salus-ct .temp-stats span{font-size:14px;color:var(--muted)}.salus-ct .temp p{font-size:14px;color:var(--muted);margin:0}.salus-ct .temp a{color:var(--teal)}\n.salus-ct .routine-title{margin-top:22px}.salus-ct .routine{margin:10px 0 16px;padding:0;list-style:none;counter-reset:r}.salus-ct .routine li{position:relative;padding:0 0 12px 34px;font-size:15px;color:var(--muted)}.salus-ct .routine li:before{counter-increment:r;content:counter(r);position:absolute;left:0;top:2px;width:22px;height:22px;border-radius:50%;background:var(--teal);color:#fff;font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center}.salus-ct .routine strong{color:var(--ink)}.salus-ct .duo p a:not(.link){color:var(--teal);text-decoration:underline}\n.salus-ct .faq{max-width:900px}.salus-ct details{border-bottom:1px solid var(--line);padding:18px 0}.salus-ct summary{cursor:pointer;font-weight:600;list-style:none;display:flex;justify-content:space-between;gap:15px}.salus-ct summary::-webkit-details-marker{display:none}.salus-ct summary:after{content:'+';color:var(--teal);font-size:23px;line-height:1}.salus-ct details[open] summary:after{content:'−'}.salus-ct details p{padding-top:12px;color:var(--muted);font-size:15px;margin:0}\n.salus-ct .cta{background:var(--forest);color:#fff;text-align:center}.salus-ct .cta h2{color:#fff}.salus-ct .cta .eyebrow{color:#bfe4da}.salus-ct .cta p{max-width:600px;margin:0 auto 26px;color:#d5e6e1}.salus-ct .cta .btns{justify-content:center}\n@media(min-width:1280px){.salus-ct .hero{display:grid;align-items:center}.salus-ct .hero-img,.salus-ct .hero-content{grid-area:1/1}.salus-ct .hero-img{justify-self:end;align-self:stretch;width:60%;height:auto;object-fit:cover;object-position:30% center;-webkit-mask-image:linear-gradient(90deg,transparent 0,#000 14%);mask-image:linear-gradient(90deg,transparent 0,#000 14%)}.salus-ct .hero-content{position:relative;background:none}.salus-ct .hero-text{max-width:min(560px,40%);padding:40px 0}}\n@media(max-width:1279px){.salus-ct .hero-content{position:relative;margin-top:-80px;padding:96px 0 52px;background:linear-gradient(to bottom,rgba(18,37,31,0),var(--deep) 80px)}.salus-ct .hero-text{max-width:640px}}\n@media(max-width:1024px){.salus-ct .steps{grid-template-columns:1fr 1fr}}\n@media(max-width:900px){.salus-ct .trust{flex-direction:column;gap:6px}}\n@media(max-width:760px){.salus-ct .wrap{padding:0 20px}.salus-ct section{padding:56px 0}.salus-ct .split,.salus-ct .grid,.salus-ct .pgrid,.salus-ct .finishes,.salus-ct .temp-stats,.salus-ct .contrast .duo,.salus-ct .loki-points{grid-template-columns:1fr}.salus-ct .steps{grid-template-columns:1fr}.salus-ct .btn{justify-content:center}.salus-ct .btns .btn{flex:1 1 100%}}\n.salus-ct .glance{margin-top:40px}.salus-ct .glance td:first-child{width:18%}\n.salus-ct .spokes .card .link{display:inline-block;margin-top:14px}.salus-ct .spokes h3{font-size:18px}\n.salus-ct .tips{margin:28px 0 0;padding:0;list-style:none;display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.salus-ct .tips li{border-top:3px solid var(--teal);padding-top:14px;font-size:15px;color:var(--muted)}.salus-ct .tips strong{display:block;color:var(--ink);margin-bottom:4px}\n.salus-ct .setup-head{margin-top:56px}\n@media(max-width:760px){.salus-ct .tips{grid-template-columns:1fr}}\n</style>\n{%- comment -%}\n  CONTRAST THERAPY GUIDE (/pages/contrast-therapy-guide). Una sola seccion Custom Liquid.\n  Estilos copiados de la guia de cold plunges (clase raiz .salus-ct). Precios y fotos de producto salen de Shopify en vivo.\n{%- endcomment -%}\n<div class=\"salus-ct\">\n  <header class=\"hero\">\n    <img class=\"hero-img\" src=\"https://cdn.shopify.com/s/files/1/0720/7695/1854/files/contrast-therapy-hero-nordic-ii-glacier.webp?v=1792685480&amp;width=1536\" srcset=\"https://cdn.shopify.com/s/files/1/0720/7695/1854/files/contrast-therapy-hero-nordic-ii-glacier.webp?v=1792685480&amp;width=750 750w, https://cdn.shopify.com/s/files/1/0720/7695/1854/files/contrast-therapy-hero-nordic-ii-glacier.webp?v=1792685480&amp;width=1100 1100w, https://cdn.shopify.com/s/files/1/0720/7695/1854/files/contrast-therapy-hero-nordic-ii-glacier.webp?v=1792685480&amp;width=1536 1536w\" sizes=\"(min-width: 1280px) 60vw, 100vw\" width=\"1536\" height=\"1024\" fetchpriority=\"high\" alt=\"Man relaxing in a Glacier cold plunge tub beside a Nordic II barrel sauna on a backyard lawn at sunset\">\n    <div class=\"hero-content\"><div class=\"wrap\"><div class=\"hero-text\">\n      <span class=\"eyebrow\">The Salus guide to heat and cold</span>\n      <h1>The contrast therapy guide.<br>Heat, then cold.</h1>\n      <p>Alternate the warmth of a sauna with the brief chill of a cold plunge. Learn how contrast therapy works, what the research supports, and how to build a routine at home.</p>\n      <div class=\"btns\"><a class=\"btn\" href=\"#ct-routine\">See the routine</a><a class=\"btn ghost\" href=\"#ct-setup\">Build your setup <span aria-hidden=\"true\">↓</span></a></div>\n      <div class=\"trust\"><span>✓ Saunas and cold plunges from one team</span><span>✓ Expert product guidance</span></div>\n    </div></div></div>\n  </header>\n  <nav class=\"toc\" aria-label=\"On this page\"><div class=\"wrap\"><a href=\"#ct-basics\"><span>01</span>The basics</a><a href=\"#ct-research\"><span>02</span>The research</a><a href=\"#ct-routine\"><span>03</span>The routine</a><a href=\"#ct-safety\"><span>04</span>Safety</a><a href=\"#ct-setup\"><span>05</span>Build your setup</a><a href=\"#ct-more\"><span>06</span>Go deeper</a><a href=\"#ct-faq\"><span>07</span>Your questions</a></div></nav>\n\n  <section class=\"intro\" id=\"ct-basics\"><div class=\"wrap split\">\n    <div><span class=\"eyebrow\">01 / The basics</span><h2>What is contrast therapy?</h2></div>\n    <div><p class=\"lead\">Contrast therapy means alternating heat and cold: a session in a sauna, followed by a short immersion in cold water, repeated for a round or two. Simple in principle, and a ritual you can make your own.</p><p>Heat widens your blood vessels and raises your heart rate. Cold narrows them and sets off the cold-shock response: a gasp, faster breathing, and a jump in heart rate and blood pressure. Moving between the two is what gives contrast therapy its distinctive feel, and why it deserves a careful start.</p><a class=\"link\" href=\"#ct-routine\">Go to the routine →</a></div>\n  </div></section>\n\n  <section id=\"ct-research\"><div class=\"wrap\">\n    <span class=\"eyebrow\">02 / What the research says</span><h2>Promising, and still being studied.</h2><p class=\"lead\">Here's what the evidence supports today, and where it's still thin.</p>\n    <div class=\"grid\">\n      <article class=\"card\"><span class=\"num\">Recovery</span><h3>After a workout</h3><p>A 2013 review of 18 trials found that alternating hot and cold water reduced muscle soreness and strength loss compared with simply resting. It wasn't clearly better than other options, such as cold water alone or compression. <a href=\"https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0062356\" target=\"_blank\" rel=\"noopener\">Read the review</a>.</p></article>\n      <article class=\"card\"><span class=\"num\">Heat</span><h3>The sauna side</h3><p>Long-running Finnish studies link regular sauna bathing with better cardiovascular health. These are observational findings about sauna use, not about contrast therapy itself. <a href=\"https://doi.org/10.1016/j.mayocp.2018.04.008\" target=\"_blank\" rel=\"noopener\">Read the evidence review</a>.</p></article>\n      <article class=\"card\"><span class=\"num\">Cold</span><h3>The plunge side</h3><p>Cold immersion may temporarily lower stress and improve sleep, but the evidence for lasting effects on mood or immunity is limited. <a href=\"https://www.health.harvard.edu/heart-health/cold-plunges-healthy-or-harmful-for-your-heart\" target=\"_blank\" rel=\"noopener\">Harvard Health on cold plunges</a>.</p></article>\n    </div>\n    <p class=\"note\">Contrast therapy is a wellness practice, not a medical treatment. It is not intended to diagnose, treat, or prevent any condition.</p>\n  </div></section>\n\n  <section class=\"products\" id=\"ct-routine\"><div class=\"wrap\">\n    <span class=\"eyebrow\">03 / Your routine</span><h2>A simple contrast therapy routine.</h2><p class=\"lead\">Start gentle. You can always add time later; you don't need to prove anything on day one.</p>\n    <div class=\"steps\">\n      <div class=\"step\"><span class=\"num\">01</span><h3>Heat</h3><p>10–20 minutes in your sauna at a temperature you find comfortable. Start at the lower end of your sauna's range.</p></div>\n      <div class=\"step\"><span class=\"num\">02</span><h3>Cool down</h3><p>1–2 minutes to step out, breathe normally, and rinse off if you like.</p></div>\n      <div class=\"step\"><span class=\"num\">03</span><h3>Cold</h3><p>1–3 minutes in the cold plunge. First-timers: a minute or two, in the 50–59°F range.</p></div>\n      <div class=\"step\"><span class=\"num\">04</span><h3>Rest &amp; repeat</h3><p>1–2 rounds, depending on how you feel. Finish by warming up gradually and drinking water.</p></div>\n    </div>\n    <div class=\"table-wrap glance\"><table>\n      <thead><tr><th>Phase</th><th>Time</th><th>Temperature</th></tr></thead>\n      <tbody>\n        <tr><td>Heat</td><td>10–20 minutes</td><td>Traditional saunas typically run 150–195°F; infrared typically 110–150°F. Choose a setting you find comfortable.</td></tr>\n        <tr><td>Cool down</td><td>1–2 minutes</td><td>Room temperature, or a lukewarm rinse</td></tr>\n        <tr><td>Cold</td><td>1–3 minutes</td><td>50–59°F for beginners. Never below 40°F or longer than 5 minutes.</td></tr>\n        <tr><td>Rounds</td><td>1–2</td><td>Stop when you've had enough</td></tr>\n      </tbody>\n    </table></div>\n    <p class=\"note\">Cold-water figures follow <a href=\"https://health.clevelandclinic.org/what-to-know-about-cold-plunges\" target=\"_blank\" rel=\"noopener\">Cleveland Clinic's cold plunge guidance</a>. Sauna ranges are typical, not product specifications; follow your sauna's manual.</p>\n  </div></section>\n\n  <section id=\"ct-safety\"><div class=\"wrap\">\n    <span class=\"eyebrow\">04 / Safety first</span><h2>Respect both extremes.</h2><p class=\"lead\">Heat and cold each put demands on your body. Together, they ask a little more.</p>\n    <div class=\"alert\"><strong>Check with your doctor first.</strong>Switching between heat and cold puts extra stress on your heart and blood vessels. Talk to your doctor before you start if you have heart disease, a heart rhythm problem, high or low blood pressure, are pregnant, or take medication that affects your heart rate or blood pressure. This guide is educational, not medical advice. Read <a href=\"https://www.health.harvard.edu/heart-health/cold-plunges-healthy-or-harmful-for-your-heart\" target=\"_blank\" rel=\"noopener\">Harvard Health's safety guidance</a>.</div>\n    <ul class=\"tips\">\n      <li><strong>Never alone, never after alcohol</strong>Have someone nearby, and skip both the sauna and the plunge if you've been drinking.</li>\n      <li><strong>Ease into the cold</strong>Enter gradually, keep your head above water, and breathe normally. Avoid holding your breath.</li>\n      <li><strong>Know when to stop</strong>Get out right away if you feel dizzy, numb, short of breath, or unwell. Hydrate before and after.</li>\n    </ul>\n  </div></section>\n\n  <section class=\"contrast\" id=\"ct-setup\"><div class=\"wrap\">\n    <span class=\"eyebrow\">05 / Build your setup</span><h2>Build a hot-cold space at home.</h2><p class=\"lead\">Two pieces, one ritual. Place them close together so the walk between heat and cold is short, level, and safe.</p>\n    <ul class=\"tips\">\n      <li><strong>Plan the power</strong>Many traditional and hybrid saunas need a dedicated 240V circuit. Chiller plunges such as the Snowpiercer and Dynamic need a dedicated 120 V, 15 amp outlet with GFCI protection.</li>\n      <li><strong>Indoors or out</strong>Choose models rated for where they'll live. Infrared saunas are indoor-only; outdoor barrel and cabin saunas are built for the weather.</li>\n      <li><strong>Ice or chiller</strong>Fill the Ice Bath with water and ice, or choose a chiller model that holds the temperature you set from a Wi-Fi app.</li>\n    </ul>\n    <div class=\"phead setup-head\"><div><h3>Heat: choose your sauna</h3></div><a class=\"link\" href=\"/pages/home-sauna-buyers-guide\">Read the sauna buyer's guide →</a></div>\n    <div class=\"pgrid\">\n      {%- assign ct_saunas = 'monarch-ii|TRADITIONAL / 3 PERSON / OUTDOOR|A traditional outdoor retreat with room to share the ritual.~prana-1-2-person-compact-infrared-sauna|INFRARED / 1 PERSON / INDOOR|A compact far infrared cabin sized for a spare room, home gym, or office corner.~renew-king|HYBRID / 3 PERSON / OUTDOOR|A traditional heater and infrared panels in one outdoor cabin, so every session can match your mood.' | split: '~' -%}\n      {%- for row in ct_saunas -%}{%- assign f = row | split: '|' -%}{%- assign product = all_products[f[0]] -%}{%- if product.id -%}{%- assign ct_alt = product.featured_image.alt | default: product.title -%}\n      <a class=\"pcard\" href=\"{{ product.url }}\">{{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(max-width: 760px) 100vw, 33vw', alt: ct_alt }}<div class=\"pbody\"><span class=\"eyebrow\">{{ f[1] }}</span><h3>{{ product.title }}</h3><p>{{ f[2] }}</p><div class=\"price\">{% if product.price_varies %}From {% endif %}{{ product.price_min | money_without_trailing_zeros }}<small>USD</small>{% if product.compare_at_price_min > product.price_min %}<s>{{ product.compare_at_price_min | money_without_trailing_zeros }}</s>{% endif %}</div><span class=\"link\">Explore this sauna →</span></div></a>\n      {%- endif -%}{%- endfor -%}\n    </div>\n    <div class=\"phead setup-head\"><div><h3>Cold: choose your plunge</h3></div><a class=\"link\" href=\"/pages/cold-plunge-guide\">Read the cold plunge guide →</a></div>\n    <div class=\"pgrid\">\n      {%- assign ct_plunges = 'salus-ice-bath|THE EVERYDAY RESET|A straightforward starting point for cold immersion at home: fill it with water and ice, no chiller needed.~snowpiercer|THE CEDAR CLASSIC|Pacific cedar, a compact barrel profile, and a Wi-Fi cold/heat chiller you control from your phone.~dynamic|ROOM TO MAKE IT YOURS|A sleek stainless-steel-lined tub with a Wi-Fi chiller, available in two rectangular sizes.' | split: '~' -%}\n      {%- for row in ct_plunges -%}{%- assign f = row | split: '|' -%}{%- assign product = all_products[f[0]] -%}{%- if product.id -%}{%- assign ct_alt = product.featured_image.alt | default: product.title -%}\n      <a class=\"pcard\" href=\"{{ product.url }}\">{{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(max-width: 760px) 100vw, 33vw', alt: ct_alt }}<div class=\"pbody\"><span class=\"eyebrow\">{{ f[1] }}</span><h3>{{ product.title }}</h3><p>{{ f[2] }}</p><div class=\"price\">{% if product.price_varies %}From {% endif %}{{ product.price_min | money_without_trailing_zeros }}<small>USD</small>{% if product.compare_at_price_min > product.price_min %}<s>{{ product.compare_at_price_min | money_without_trailing_zeros }}</s>{% endif %}</div><span class=\"link\">Explore this plunge →</span></div></a>\n      {%- endif -%}{%- endfor -%}\n    </div>\n    <p class=\"note\">Looking for a statement piece? <a class=\"link\" href=\"/collections/loki-series\">Explore the Loki Series →</a> · <a class=\"link\" href=\"/collections/all-saunas\">Shop all saunas →</a> · <a class=\"link\" href=\"/collections/cold-plunges\">Shop all cold plunges →</a></p>\n  </div></section>\n\n  <section class=\"spokes\" id=\"ct-more\"><div class=\"wrap\">\n    <span class=\"eyebrow\">06 / Go deeper</span><h2>More on heat and cold.</h2>\n    <div class=\"grid\">\n      <article class=\"card\"><span class=\"num\">Circulation</span><h3>Contrast therapy for circulation and lymphatic flow</h3><a class=\"link\" href=\"/blogs/blog/contrast-therapy-for-better-circulation-and-lymphatic-flow\">Read the article →</a></article>\n      <article class=\"card\"><span class=\"num\">Cooling down</span><h3>Cold showers and ice baths after a sauna</h3><a class=\"link\" href=\"/blogs/blog/the-art-of-cooling-down-cold-showers-and-ice-baths-after-saunas\">Read the article →</a></article>\n      <article class=\"card\"><span class=\"num\">Cold options</span><h3>Cryotherapy chambers vs. cold plunges</h3><a class=\"link\" href=\"/blogs/blog/cryotherapy-vs-cold-plunges\">Read the article →</a></article>\n    </div>\n  </div></section>\n\n  <section id=\"ct-faq\"><div class=\"wrap faq\">\n    <span class=\"eyebrow\">07 / A little more clarity</span><h2>Contrast therapy questions, answered.</h2><p class=\"lead\">Still deciding what to pair? Call a Salus specialist at <a class=\"link\" href=\"tel:+18882870111\">(888) 287-0111</a>.</p>\n    <details><summary>What is contrast therapy?</summary><p>Contrast therapy means alternating heat and cold: a session in a sauna, followed by a short immersion in cold water, repeated for a round or two. It is a wellness practice, not a medical treatment.</p></details>\n    <details><summary>How long should you stay in the sauna and the cold plunge?</summary><p>A common starting point is 10 to 20 minutes of heat at a temperature you find comfortable, a minute or two to cool down, then 1 to 3 minutes in cold water. Cleveland Clinic suggests beginners keep cold sessions to a minute or two, at 50 to 59°F, and never stay in longer than five minutes or go below 40°F.</p></details>\n    <details><summary>How many rounds of contrast therapy should I do?</summary><p>Start with one or two rounds. More rounds are not automatically better. Stop when you feel you have had enough, and get out right away if you feel dizzy, numb, or unwell.</p></details>\n    <details><summary>Should I end on hot or cold?</summary><p>There is no clear evidence either way. Some people like to finish with cold because it feels invigorating; others prefer to finish with gentle warmth. Whichever you choose, warm up gradually afterward and listen to your body.</p></details>\n    <details><summary>Is contrast therapy safe?</summary><p>Switching between heat and cold puts extra stress on your heart and blood vessels. Talk to your doctor first if you have heart disease, a heart rhythm problem, high or low blood pressure, are pregnant, or take medication that affects your heart rate or blood pressure. Never plunge alone or after drinking alcohol.</p></details>\n    <details><summary>Can I do contrast therapy with an infrared sauna?</summary><p>Yes. Infrared saunas run at lower air temperatures than traditional saunas, typically 110 to 150°F, so the heat phase can feel gentler. Follow your sauna's manual for session length and temperature.</p></details>\n    <details><summary>Can I use a cold shower instead of a cold plunge?</summary><p>Yes. A cold shower is a simpler way to cool down, though it is less immersive and harder to keep at a steady temperature. A dedicated cold plunge lets you control the water temperature and the length of each session.</p></details>\n    <details><summary>Do I need a chiller for contrast therapy?</summary><p>No. The Salus Saunas Ice Bath is designed for a simple water-and-ice fill. The Snowpiercer and Dynamic include a cold/heat chiller with Wi-Fi app control that holds the temperature you set, which makes regular sessions easier.</p></details>\n  </div></section>\n\n  <section class=\"cta\"><div class=\"wrap\">\n    <span class=\"eyebrow\">Heat, then cold</span><h2>Your ritual starts with the right pair.</h2><p>Let's find the sauna and cold plunge that fit your space, your power, and your routine.</p>\n    <div class=\"btns\"><a class=\"btn\" href=\"/collections/all-saunas\">Shop saunas</a><a class=\"btn\" href=\"/collections/cold-plunges\">Shop cold plunges</a><a class=\"btn ghost\" href=\"tel:+18882870111\">Call (888) 287-0111</a></div>\n  </div></section>\n</div>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.salussaunas.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Contrast Therapy Guide\",\"item\":\"https://www.salussaunas.com/pages/contrast-therapy-guide\"}]},{\"@type\":\"Article\",\"@id\":\"https://www.salussaunas.com/pages/contrast-therapy-guide#article\",\"headline\":\"The Contrast Therapy Guide\",\"description\":\"How contrast therapy works, a simple sauna and cold plunge routine, what the research says, safety basics, and how to build a hot-cold setup at home.\",\"mainEntityOfPage\":\"https://www.salussaunas.com/pages/contrast-therapy-guide\",\"image\":\"https://cdn.sho